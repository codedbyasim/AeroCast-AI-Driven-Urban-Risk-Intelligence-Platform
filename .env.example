# =======================================================
# AeroCast — M1 Data Ingestion Environment Variables
# =======================================================

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# OpenAQ API Key (Register at https://openaq.org to get a key; optional for basic queries)
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3
OPENAQ_POLL_INTERVAL_MINUTES=30

# Open-Meteo API Endpoints
OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_HISTORICAL_URL=https://archive-api.open-meteo.com/v1/archive
OPENMETEO_POLL_INTERVAL_MINUTES=60

# Lahore Centroid Coordinates
LAHORE_LATITUDE=31.5204
LAHORE_LONGITUDE=74.3587

# Lahore Bounding Box (min_lon, min_lat, max_lon, max_lat)
LAHORE_BBOX_MIN_LON=74.10
LAHORE_BBOX_MIN_LAT=31.30
LAHORE_BBOX_MAX_LON=74.55
LAHORE_BBOX_MAX_LAT=31.65

# Data Paths (Custom paths to shapefiles / GeoTIFFs if available)
OSM_HDX_UC_BOUNDARY_PATH=data/boundaries/lahore_union_councils.geojson
WORLDPOP_RASTER_PATH=data/rasters/worldpop_lahore_pop_density.tif
COPERNICUS_DEM_RASTER_PATH=data/rasters/copernicus_lahore_dem.tif
COPERNICUS_NDVI_RASTER_PATH=data/rasters/copernicus_lahore_ndvi.tif

# Copernicus Data Space Ecosystem (CDSE) API Credentials for Sentinel-2 NDVI
# Register a free account at https://dataspace.copernicus.eu/
# Generate OAuth client credentials in user settings -> API Keys
# CDSE_CLIENT_ID=
# CDSE_CLIENT_SECRET=

# Cache Settings
CACHE_DIR=.cache
CACHE_FORMAT=json
CACHE_EXPIRY_HOURS=24

# Retry & Timeout Policy
HTTP_TIMEOUT_SECONDS=15.0
MAX_RETRIES=3
RETRY_BACKOFF_MIN_SECONDS=1.0
RETRY_BACKOFF_MAX_SECONDS=10.0

# AIML API Configuration (Powered by Gemini 2.5 Flash)
AIML_API_KEY=
AIML_API_BASE_URL=https://api.aimlapi.com/v1
AIML_MODEL=google/gemini-2.5-flash
